<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ title ? title + " | " : "" }}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href="{{ site.domain }}{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" href="/blog/feed.xml">
  {% if jsonld %}<script type="application/ld+json">
  {{ jsonld | safe }}
  </script>{% endif %}
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="antialiased text-slate-800">
  <header class="max-w-5xl mx-auto px-4 py-6 flex items-center justify-between">
    <a href="/" class="text-xl font-semibold">{{ site.brand }}</a>
    <nav class="flex gap-6">
      <a href="/" class="hover:underline">Home</a>
      <a href="/shop.html" class="hover:underline">Shop</a>
      <a href="/flight-baggage-limits.html" class="hover:underline">Airlines</a>
      <a href="/manual.html" class="hover:underline">Manual</a>
      <a href="/blog/" class="font-semibold underline">Blog</a>
    </nav>
  </header>
  <main class="max-w-5xl mx-auto px-4 py-6">{{ content | safe }}</main>
  <footer class="max-w-5xl mx-auto px-4 py-10 text-sm text-slate-500">
    <p>{{ site.affiliateDisclosure }}</p>
    <p class="mt-2">© {{ (new Date()).getFullYear() }} {{ site.brand }}.</p>
  </footer>
</body>
</html>
