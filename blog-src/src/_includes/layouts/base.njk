<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ title ? title + " | " : "" }}uPatch Travel Blog</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or 'Smart packing, baggage rules, and tools to avoid fees.' }}">
  <link rel="canonical" href="https://luggage-scale.com{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" href="/blog/feed.xml">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="antialiased text-slate-800">
  <header class="max-w-5xl mx-auto px-4 py-6 flex items-center justify-between">
    <a href="/" class="text-xl font-semibold">uPatch</a>
    <nav class="flex gap-6">
      <a href="/" class="hover:underline">Home</a>
      <a href="/shop.html" class="hover:underline">Shop</a>
      <a href="/flight-baggage-limits.html" class="hover:underline">Airlines</a>
      <a href="/manual.html" class="hover:underline">Manual</a>
      <a href="/blog/" class="font-semibold underline">Blog</a>
    </nav>
  </header>
  <main class="max-w-5xl mx-auto px-4 py-6">
    {{ content | safe }}
  </main>
  <footer class="max-w-5xl mx-auto px-4 py-10 text-sm text-slate-500">
    <p>As an Amazon Associate, we earn from qualifying purchases.</p>
  </footer>
</body>
</html>
