---
permalink: /blog/feed.xml
eleventyExcludeFromCollections: true
---
{% set posts = collections.post | reverse %}
<?xml version="1.0" encoding="utf-8"?>
<rss xmlns:atom="http://www.w3.org/2005/Atom" version="2.0">
  <channel>
    <title>{{ site.name }}</title>
    <link>{{ site.domain }}/blog/</link>
    <atom:link href="{{ site.domain }}/blog/feed.xml" rel="self" type="application/rss+xml"/>
    <description>{{ site.description }}</description>
    {% for post in posts %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ site.domain }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.domain }}{{ post.url }}</guid>
      <description>{{ post.data.description }}</description>
      <pubDate>{{ post.date | dateToRfc822 }}</pubDate>
    </item>
    {% endfor %}
  </channel>
</rss>
