---
layout: "blog.njk"
title: "Blog"
description: "Latest articles, guides, and tips from the uPatch luggage scale team."
pagination:
  data: collections.posts
  size: 10
  alias: paged
permalink: "{% if pagination.pageNumber == 0 %}index.html{% else %}page-{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
---

{# Debug line to verify posts are being collected #}
<p style="color:red; font-weight:bold;">
DEBUG: Found {{ collections.posts | length }} posts. 
Showing page {{ pagination.pageNumber + 1 }} of {{ pagination.pages | length }}
</p>

<h1>Latest Posts</h1>

<ul>
{% for post in paged %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a> — 
    <time datetime="{{ post.date | isoDate }}">{{ post.date | date("MMMM d, yyyy") }}</time>
  </li>
{% endfor %}
</ul>

<nav>
  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}">← Newer</a>
  {% endif %}
  {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}">Older →</a>
  {% endif %}
</nav>
