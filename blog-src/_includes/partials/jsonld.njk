{# Minimal, safe JSON-LD for blog posts; renders only on posts #}
{% set isPost = page.inputPath and page.inputPath.startsWith("./blog-src/posts/") %}
{% if isPost %}
  {% set ldTitle = title or config.site.defaultTitle or "Blog post" %}
  {% set ldDesc  = description or config.site.description %}
  {% set ldUrl   = (config.site.origin + page.url) %}
  {% set ldImg   = ogImage or config.site.defaultOgImage %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "{{ ldTitle | replace('"', '\\"') }}",
    "description": "{{ ldDesc | replace('"', '\\"') }}",
    "url": "{{ ldUrl }}",
    "datePublished": "{{ (date or page.date) | date('yyyy-LL-dd\'T\'HH:mm:ssZZ') }}",
    "dateModified": "{{ (updateDate or page.date) | date('yyyy-LL-dd\'T\'HH:mm:ssZZ') }}",
    {% if ldImg %}"image": "{{ ldImg }}",{% endif %}
    "publisher": {
      "@type": "Organization",
      "name": "{{ config.site.name | replace('"', '\\"') }}"
    }
  }
  </script>
{% endif %}
