{# blog-src/_includes/partials/head-meta.njk
   Safe, parser-friendly meta partial for Nunjucks/Eleventy.

   Inputs (optional via page/front matter or include params):
   - title, description, ogImage, noindex
   Uses site-wide config from blog-src/_data/config.json:
   - siteName, siteTagline, siteUrl (prefer no trailing slash), brandColor,
     twitterHandle, defaultOgImage, authorName, logoUrl
#}

{# ---- Resolve core values with safe fallbacks ---- #}
{% set site = config or {} %}
{% set baseUrl = site.siteUrl or '' %}
{# NOTE: fine if this produces // — browsers handle it. Prefer siteUrl without trailing slash. #}
{% set _url   = (baseUrl) ~ (page.url or '') %}
{% set _title = title or page.title or site.siteName or 'Luggage Scale Blog' %}
{% set _desc  = description or page.description or site.siteTagline or '' %}
{% set _img   = ogImage or page.ogImage or site.defaultOgImage or '' %}
{% set _brand = site.brandColor or '#6b7280' %}
{% set _noidx = noindex or page.noindex or site.noindex %}

{# Detect post-ish pages: any /blog/... that isn’t the blog index #}
{% set isPost = page.url and ('/blog/' in page.url) and (page.url != '/blog/') %}

{# ---- Standard meta + canonical ---- #}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{{ _title }}</title>
<link rel="canonical" href="{{ _url }}">

<meta name="description" content="{{ _desc }}">
{% if _noidx %}
  <meta name="robots" content="noindex, nofollow">
{% else %}
  <meta name="robots" content="index, follow">
{% endif %}
<meta name="theme-color" content="{{ _brand }}">

{# ---- Open Graph ---- #}
<meta property="og:site_name" content="{{ site.siteName or 'Luggage Scale' }}">
<meta property="og:title" content="{{ _title }}">
<meta property="og:description" content="{{ _desc }}">
<meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ _url }}">
{% if _img %}<meta property="og:image" content="{{ _img }}">{% endif %}

{# ---- Twitter Cards ---- #}
<meta name="twitter:card" content="summary_large_image">
{% if site.twitterHandle %}
  <meta name="twitter:site" content="@{{ site.twitterHandle | replace('@','') }}">
{% endif %}
<meta name="twitter:title" content="{{ _title }}">
<meta name="twitter:description" content="{{ _desc }}">
{% if _img %}<meta name="twitter:image" content="{{ _img }}">{% endif %}

{# ---- JSON-LD: Article for posts, WebPage otherwise ---- #}
{% if isPost %}
  {# Dates for schema (requires your .eleventy.js date filter). If missing, these lines still parse. #}
  {% set _published = page.date | date('yyyy-LL-dd') %}
  {% set _modified  = (page.lastModified or page.date) | date('yyyy-LL-dd') %}
  {% set _author    = site.authorName or site.siteName or 'Luggage Scale' %}
  {% set _logo      = site.logoUrl or '' %}

  {% set article_json %}
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ _title | escape }}",
  "description": "{{ _desc | escape }}",
  "url": "{{ _url }}",
  {% if _img %}"image": ["{{ _img }}"],{% endif %}
  "datePublished": "{{ _published }}",
  "dateModified": "{{ _modified }}",
  "author": { "@type": "Person", "name": "{{ _author | escape }}" },
  "publisher": {
    "@type": "Organization",
    "name": "{{ (site.siteName or 'Luggage Scale') | escape }}"{% if _logo %},
    "logo": { "@type": "ImageObject", "url": "{{ _logo }}" }{% endif %}
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ _url }}" }
}
  {% endset %}
  <script type="application/ld+json">{{ article_json | safe }}</script>

  {# Simple breadcrumb (Blog → Current) #}
  {% set breadcrumb_json %}
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1,
      "name": "Blog", "item": "{{ (site.siteUrl or '') ~ '/blog/' }}" },
    { "@type": "ListItem", "position": 2,
      "name": "{{ _title | escape }}", "item": "{{ _url }}" }
  ]
}
  {% endset %}
  <script type="application/ld+json">{{ breadcrumb_json | safe }}</script>
{% else %}
  {% set webpage_json %}
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ _title | escape }}",
  "description": "{{ _desc | escape }}",
  "url": "{{ _url }}"
}
  {% endset %}
  <script type="application/ld+json">{{ webpage_json | safe }}</script>
{% endif %}
