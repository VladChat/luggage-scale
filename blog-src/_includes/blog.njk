---
layout: false
pagination:
  data: collections.post
  size: 10
  reverse: true
title: "Blog — Luggage Scale Blog"
description: "Latest articles, guides, and tips from the uPatch luggage scale team."
permalink: "index.html"
---

<!doctype html>
<html lang="en">
<head>
  {% include "head.njk" %}
</head>
<body>
  <header>
    <h1>Luggage Scale Blog</h1>
  </header>

  <main>
    <h2>Latest Posts</h2>
    <ul>
      {% for post in pagination.items %}
        <li>
          <a href="{{ post.url | url }}">{{ post.data.title }}</a>
          — {{ post.date | date("MMMM D, YYYY") }}
        </li>
      {% endfor %}
    </ul>

    {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}">Newer</a>
    {% endif %}
    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}">Older →</a>
    {% endif %}
  </main>

  <footer>
    <p>© {{ now | date("YYYY") }} — <a href="/blog/">Blog Index</a> • <a href="/blog/sitemap.xml">Sitemap</a></p>
  </footer>
</body>
</html>
