{# blog-src/_includes/blog.njk #}
<!doctype html>
<html lang="en">
<head>
  {# All meta, canonical, OG/Twitter, etc. live in partials #}
  {% include "partials/head-meta.njk" %}
  {% include "partials/jsonld.njk" %}
</head>
<body>
  <header class="site-header" style="border-bottom:1px solid #eee;padding:1rem 0;">
    <div class="container">
      <a href="{{ config.site.base }}/" style="text-decoration:none;">
        <h1 style="margin:0; font-size:1.25rem;">{{ config.site.name }}</h1>
      </a>
    </div>
  </header>

  <main class="container" style="padding:1.25rem 0;">
    <nav class="breadcrumbs" aria-label="Breadcrumbs" style="font-size:.9rem; margin-bottom:1rem;">
      <a href="{{ config.site.base }}/">Blog</a>
      {% if title and page.url != config.site.base + '/' %} › <span>{{ title }}</span>{% endif %}
    </nav>

    {# Page/post content gets injected here #}
    {% block content %}{% endblock %}
  </main>

  <footer style="border-top:1px solid #eee; padding:1rem 0;">
    <div class="container" style="font-size:.9rem;">
      © {{ page.date | date("yyyy") }} — 
      <a href="{{ config.site.base }}/">Blog Index</a> • 
      <a href="{{ config.site.base }}/sitemap.xml">Sitemap</a>
    </div>
  </footer>
</body>
</html>
