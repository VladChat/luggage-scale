{% macro icon(name, className='') %}
  {% if className %}
    {% set classes = ' ' ~ className %}
  {% else %}
    {% set classes = '' %}
  {% endif %}
  {% if name == 'scale' %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 5h16l-2 6.5a6 6 0 0 1-12 0L4 5z" fill="currentColor" opacity="0.85"/>
      <path d="M12 11a4 4 0 0 0 4-4H8a4 4 0 0 0 4 4z" fill="currentColor"/>
      <path d="M11 14h2v7h-2z" fill="currentColor"/>
    </svg>
  {% elif name == 'intro' %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="10" fill="currentColor" opacity="0.16"/>
      <circle cx="12" cy="12" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="12" cy="9" r="1" fill="currentColor"/>
      <path d="M11.2 12.2h1.6V17h-1.6z" fill="currentColor"/>
    </svg>
  {% elif name == 'target' %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.45"/>
      <circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="12" cy="12" r="2" fill="currentColor"/>
      <path d="M12 3v2M21 12h-2M12 21v-2M5 12H3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  {% elif name == 'checklist' %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="4" y="4" width="16" height="16" rx="2.4" fill="none" stroke="currentColor" stroke-width="1.4"/>
      <path d="M9 9l1.6 1.6 3.4-3.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M8 14.5h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M8 17.5h6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.7"/>
    </svg>
  {% elif name == 'compare' %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6 4h4l-4 6h4l-4 6h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M14 4h4l-4 6h4l-4 6h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.7"/>
    </svg>
  {% elif name == 'lightbulb' %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3a6.5 6.5 0 0 0-3.6 12c.6.4 1.1 1.2 1.2 2l.1 1.5h4.6l.1-1.5c.1-.8.6-1.6 1.2-2A6.5 6.5 0 0 0 12 3z" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <path d="M10 20h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M9.5 22h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.8"/>
    </svg>
  {% elif name == 'help' %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/>
      <path d="M9.9 9.2a2.1 2.1 0 0 1 2.1-1.7c1.1 0 2 .7 2 1.7 0 1.1-.7 1.5-1.4 1.9-.8.4-1.3.8-1.3 1.8v.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <circle cx="12" cy="16.8" r="1.1" fill="currentColor"/>
    </svg>
  {% elif name == 'flag' %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6 3v18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M6 4.5h10l-1.2 3 1.2 3H6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>
  {% elif name == 'note' %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="5" y="4" width="14" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <path d="M8 9h8M8 12h6M8 15h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  {% elif name == 'arrow-right' %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {% elif name == 'chevron-down' or name == 'chevron' %}
    <svg class="icon{{ classes }}" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path d="M5 7l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {% elif name == 'toc' %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="5" y="6" width="14" height="2" rx="1" fill="currentColor"/>
      <rect x="5" y="11" width="9" height="2" rx="1" fill="currentColor" opacity="0.8"/>
      <rect x="5" y="16" width="6" height="2" rx="1" fill="currentColor" opacity="0.6"/>
    </svg>
  {% else %}
    <svg class="icon{{ classes }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <path d="M12 7v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <circle cx="12" cy="17" r="1" fill="currentColor"/>
    </svg>
  {% endif %}
{% endmacro %}





