{% from "icons.njk" import icon %}

{% macro renderToc(items, prefix) %}
  <ol class="post__toc-list">
    {% for section in items %}
    <li class="toc-item">
      <div class="toc-item__row">
        <a class="toc-item__link" href="#{{ section.id }}">{{ section.headingText }}</a>
        {% if section.subheadings and (section.subheadings | length) %}
        {% set controlId = prefix ~ "-toc-sublist-" ~ loop.index %}
        <button class="toc-item__toggle" type="button" aria-expanded="false" aria-controls="{{ controlId }}">
          <span class="visually-hidden">Toggle subsections for {{ section.headingText }}</span>
          {{ icon('chevron-down', 'toc-item__chevron') }}
        </button>
        {% endif %}
      </div>
      {% if section.subheadings and (section.subheadings | length) %}
      <ol class="toc-sublist" id="{{ prefix }}-toc-sublist-{{ loop.index }}" hidden>
        {% for sub in section.subheadings %}
        <li class="toc-sublist__item">
          <a class="toc-sublist__link" href="#{{ sub.id }}">{{ sub.text }}</a>
        </li>
        {% endfor %}
      </ol>
      {% endif %}
    </li>
    {% endfor %}
  </ol>
{% endmacro %}

{% macro renderAffiliate(card) %}
  {% if card %}
  <aside class="affiliate-card" data-affiliate-card>
    <div class="affiliate-card__media">
      {% if card.image %}
      <img src="{{ card.image }}" alt="{{ card.imageAlt }}" loading="lazy" decoding="async">
      {% else %}
      <div class="affiliate-card__icon">{{ icon('scale') }}</div>
      {% endif %}
    </div>
    <div class="affiliate-card__body">
      <span class="affiliate-card__eyebrow">Affiliate spotlight</span>
      <h3 class="affiliate-card__title">{{ card.title }}</h3>
      {% if card.description %}
      <p class="affiliate-card__description">{{ card.description }}</p>
      {% endif %}
      <div class="affiliate-card__actions">
        <a class="btn solid btn--accent" href="{{ card.url }}" rel="sponsored noopener noreferrer" target="_blank">
          <span class="btn__icon" aria-hidden="true">{{ icon('arrow-right') }}</span>
          <span class="btn__text">{{ card.ctaText }}</span>
        </a>
      </div>
      {% if card.disclaimer %}
      <p class="affiliate-card__disclaimer">{{ card.disclaimer }}</p>
      {% endif %}
    </div>
  </aside>
  {% endif %}
{% endmacro %}
